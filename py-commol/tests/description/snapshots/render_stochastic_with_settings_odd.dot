digraph "states" {
    rankdir=LR;
    n0 [label="A"];
    n1 [label="B"];
    inflow [shape=point, label=""];
    outflow [shape=point, label=""];
    n0 -> n1 [label=""];
    n1 -> n1 [label="0 * A * B"];
    inflow -> n0 [label="0"];
    inflow -> n1 [label="0"];
    n1 -> outflow [label="0"];
}
digraph "compartments" {
    rankdir=LR;
    n0 [label="A"];
    n1 [label="B"];
    inflow [shape=point, label=""];
    outflow [shape=point, label=""];
    n0 -> n1 [label="ab: 0 * A * B"];
    n1 -> n1 [label="ab: 0 * A * B"];
    inflow -> n0 [label="in: 0"];
    inflow -> n1 [label="in: 0"];
    n1 -> outflow [label="out: 0 * B"];
    n0 -> n1 [label="dose: 0 * A"];
}