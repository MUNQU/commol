                  "relation": "equals"
                },
                {
                  "left": "[C(t+Dt) - C(t)] / Dt",
                  "right": "(k2 * B)",
                  "left_latex": "\\frac{C(t+\\Delta t) - C(t)}{\\Delta t}",
                  "right_latex": "(k2 \\cdot B)",
                  "relation": "equals"
