              "A -1, B +1",
              "0 * A * B"
            ],
            [
              "in",
              "A +1, B +1",
              "0"
            ],
            [
              "out",
              "B -1",
              "0 * B"
            ]
          ]
        },
        {
          "type": "text",
          "heading": null,
          "text": "Each event moves one unit. A flow has no events while one of its sources holds fewer units than an event takes."
        },
        {
          "type": "equations",
          "heading": "Impulses",
          "title": null,
          "groups": [
            {
              "heading": "dose, impulse at 1",
              "equations": [
                {
                  "left": "A -> B",
                  "right": "0 * A",
                  "left_latex": "A \\to B",
                  "right_latex": "0 \\cdot A",
                  "relation": "flow"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "heading": "Neighbors",
          "text": "Every unit is a neighbor of every other (Complete): neighbors_<bin> is the bin total and neighbors is total."
        },
