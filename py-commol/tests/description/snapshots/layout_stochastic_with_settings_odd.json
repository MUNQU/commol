              "source": "A",
              "target": "B",
              "label": "dose: 0 * A"
            }
          ],
          "expanded": true
        },
        {
          "type": "equations",
          "heading": "Compact form",
          "title": "Bin Transitions",
          "groups": [
            {
              "heading": "ab (A, B -> B)",
              "equations": [
                {
                  "left": "A -> B",
                  "right": "0 * A * B",
                  "left_latex": "A \\to B",
                  "right_latex": "0 \\cdot A \\cdot B",
                  "relation": "flow"
                },
                {
                  "left": "B -> B",
                  "right": "0 * A * B",
                  "left_latex": "B \\to B",
                  "right_latex": "0 \\cdot A \\cdot B",
                  "relation": "flow"
                }
              ]
            },
            {
              "heading": "in (none -> A, B)",
              "equations": [
                {
                  "left": "none -> A",
                  "right": "0",
                  "left_latex": "\\varnothing \\to A",
                  "right_latex": "0",
                  "relation": "flow"
                },
                {
                  "left": "none -> B",
                  "right": "0",
                  "left_latex": "\\varnothing \\to B",
                  "right_latex": "0",
                  "relation": "flow"
                }
              ]
            },
            {
              "heading": "out (B -> none)",
              "equations": [
                {
                  "left": "B -> none",
                  "right": "0 * B",
                  "left_latex": "B \\to \\varnothing",
                  "right_latex": "0 \\cdot B",
                  "relation": "flow"
                }
              ]
            },
            {
              "heading": "dose (A -> B, impulse at 1)",
              "equations": [
                {
                  "left": "A -> B",
                  "right": "0 * A",
                  "left_latex": "A \\to B",
                  "right_latex": "0 \\cdot A",
                  "relation": "flow"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "heading": null,
          "text": "Total System: 2 coupled equations (2 bins)"
        },
