digraph "states" {
    rankdir=LR;
    n0 [label="State A"];
    n1 [label="State B"];
    n2 [label="State C"];
    n3 [label="g1"];
    n4 [label="g2"];
    n0 -> n2 [label="pair: k1 * A * B"];
    n1 -> n2 [label="pair: k1 * A * B"];
    n0 -> n1 [label="spread: k1 * A * B / total"];
    n1 -> n1 [label="spread: k1 * A * B / total"];
    n0 -> n1 [label="split: 0.05"];
    n0 -> n2 [label="split: 0.05"];
    n1 -> n1 [label="loop: 0.1"];
    in7 [shape=point, label=""];
    in7 -> n0 [label="inflow: b"];
    n0 -> n1 [label="dose: 0.1"];
    out9 [shape=point, label=""];
    n2 -> out9 [label="outflow: 0.01"];
    n3 -> n4 [label="move: stratified rates"];
    n0 -> n2 [label="pending: no rate"];
    n1 -> n2 [label="boost: 0.5"];
}
digraph "compartments" {
    rankdir=LR;
    n0 [label="A_g1"];
    n1 [label="A_g2"];
    n2 [label="B_g1"];
    n3 [label="B_g2"];
    n4 [label="C_g1"];
    n5 [label="C_g2"];
    n0 -> n4 [label="pair: k1 * A * B"];
    n2 -> n4 [label="pair: k1 * A * B"];
    n1 -> n5 [label="pair: k1 * A * B"];
    n3 -> n5 [label="pair: k1 * A * B"];
    n0 -> n2 [label="spread: k1 * A * B / total"];
    n2 -> n2 [label="spread: k1 * A * B / total"];
    n1 -> n3 [label="spread: k1 * A * B / total"];
    n3 -> n3 [label="spread: k1 * A * B / total"];
    n0 -> n2 [label="split: 0.05 * A_g1"];
    in9 [shape=point, label=""];
    in9 -> n4 [label="split: 0.05 * A_g1"];
    n1 -> n3 [label="split: 0.05 * A_g2"];
    in11 [shape=point, label=""];
    in11 -> n5 [label="split: 0.05 * A_g2"];
    n2 -> n2 [label="loop: 0.1 * B_g1"];
    n3 -> n3 [label="loop: 0.1 * B_g2"];
    in14 [shape=point, label=""];
    in14 -> n0 [label="inflow: b"];
    in15 [shape=point, label=""];
    in15 -> n1 [label="inflow: b"];
    n0 -> n2 [label="dose: 0.1 * A_g1"];
    n1 -> n3 [label="dose: 0.1 * A_g2"];
    out18 [shape=point, label=""];
    n4 -> out18 [label="outflow: 0.01 * C_g1"];
    out19 [shape=point, label=""];
    n5 -> out19 [label="outflow: 0.01 * C_g2"];
    n0 -> n1 [label="move: 0.02 * A_g1"];
    n2 -> n3 [label="move: 0.02 * B_g1"];
    n4 -> n5 [label="move: 0.02 * C_g1"];
    n2 -> n4 [label="boost: 0.5 * B_g1"];
    n3 -> n5 [label="boost: 0.5 * B_g2"];
}