digraph "states" {
    rankdir=LR;
    n0 [label="State A"];
    n1 [label="State B"];
    n2 [label="State C"];
    inflow [shape=point, label=""];
    outflow [shape=point, label=""];
    n0 -> n2 [label="k1"];
    n1 -> n2 [label="k1"];
    n0 -> n1 [label="k1"];
    n1 -> n1 [label="k1"];
    inflow -> n0 [label="b"];
    n2 -> outflow [label="0.01"];
}
digraph "strata" {
    rankdir=LR;
    n0 [label="g1"];
    n1 [label="g2"];
    n0 -> n1 [label="A, B, C: 0.02"];
}
digraph "compartments" {
    rankdir=LR;
    n0 [label="A_g1"];
    n1 [label="A_g2"];
    n2 [label="B_g1"];
    n3 [label="B_g2"];
    n4 [label="C_g1"];
    n5 [label="C_g2"];
    inflow [shape=point, label=""];
    outflow [shape=point, label=""];
    n0 -> n4 [label="pair: k1 * A * B"];
    n2 -> n4 [label="pair: k1 * A * B"];
    n1 -> n5 [label="pair: k1 * A * B"];
    n3 -> n5 [label="pair: k1 * A * B"];
    n0 -> n2 [label="spread: k1 * A * B / total"];
    n2 -> n2 [label="spread: k1 * A * B / total"];
    n1 -> n3 [label="spread: k1 * A * B / total"];
    n3 -> n3 [label="spread: k1 * A * B / total"];
    n0 -> n2 [label="split: 0.05 * A_g1"];
    inflow -> n4 [label="split: 0.05 * A_g1"];
    n1 -> n3 [label="split: 0.05 * A_g2"];
    inflow -> n5 [label="split: 0.05 * A_g2"];
    n2 -> n2 [label="loop: 0.1 * B_g1"];
    n3 -> n3 [label="loop: 0.1 * B_g2"];
    inflow -> n0 [label="inflow: b"];
    inflow -> n1 [label="inflow: b"];
    n0 -> n2 [label="dose: 0.1 * A_g1"];
    n1 -> n3 [label="dose: 0.1 * A_g2"];
    n4 -> outflow [label="outflow: 0.01 * C_g1"];
    n5 -> outflow [label="outflow: 0.01 * C_g2"];
    n0 -> n1 [label="move: 0.02 * A_g1"];
    n2 -> n3 [label="move: 0.02 * B_g1"];
    n4 -> n5 [label="move: 0.02 * C_g1"];
    n2 -> n4 [label="boost: 0.5 * B_g1"];
    n3 -> n5 [label="boost: 0.5 * B_g2"];
}