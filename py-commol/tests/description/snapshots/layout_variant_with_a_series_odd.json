          "type": "equations",
          "heading": "Compact form",
          "title": "Bin Transitions",
          "groups": [
            {
              "heading": "ab (A -> B)",
              "equations": [
                {
                  "left": "A -> B",
                  "right": "k1 * A * B / total",
                  "left_latex": "A \\to B",
                  "right_latex": "\\frac{k1 \\cdot A \\cdot B}{total}",
                  "relation": "flow"
                }
              ]
            },
            {
              "heading": "bc (B -> C)",
              "equations": [
                {
                  "left": "B -> C",
                  "right": "k2 * B",
                  "left_latex": "B \\to C",
                  "right_latex": "k2 \\cdot B",
                  "relation": "flow"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "heading": null,
          "text": "Total System: 3 coupled equations (3 bins)"
        },
        {
          "type": "equations",
          "heading": "Expanded form",
          "title": null,
          "groups": [
            {
              "heading": null,
              "equations": [
                {
                  "left": "[A(t+Dt) - A(t)] / Dt",
                  "right": "- (k1 * A * B / total)",
                  "left_latex": "\\frac{A(t+\\Delta t) - A(t)}{\\Delta t}",
                  "right_latex": "- (\\frac{k1 \\cdot A \\cdot B}{total})",
                  "relation": "equals"
                },
                {
                  "left": "[B(t+Dt) - B(t)] / Dt",
                  "right": "(k1 * A * B / total) - (k2 * B)",
                  "left_latex": "\\frac{B(t+\\Delta t) - B(t)}{\\Delta t}",
                  "right_latex": "(\\frac{k1 \\cdot A \\cdot B}{total}) - (k2 \\cdot B)",
                  "relation": "equals"
                },
                {
                  "left": "[C(t+Dt) - C(t)] / Dt",
                  "right": "(k2 * B)",
                  "left_latex": "\\frac{C(t+\\Delta t) - C(t)}{\\Delta t}",
                  "right_latex": "(k2 \\cdot B)",
                  "relation": "equals"
                }
              ]
            }
          ]
        },
